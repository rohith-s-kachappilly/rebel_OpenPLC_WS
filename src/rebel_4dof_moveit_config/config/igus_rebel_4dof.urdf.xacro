<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="igus_rebel_4dof">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import igus_rebel_4dof urdf file -->
    <xacro:include filename="$(find irc_ros_description)/urdf/igus_rebel_4dof.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="igus_rebel_4dof.ros2_control.xacro" />


    <xacro:igus_rebel_4dof_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
